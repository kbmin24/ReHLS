{
  "name": "rehls",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:worker": "node --env-file=.env.local --import tsx server/src/worker/index.ts",
    "migrate:local": "node --env-file=.env.local --import tsx db/migrate.ts",
    "admin:local": "node --env-file=.env.local --import tsx server/src/cli/create-admin.ts",
    "start": "node dist/server/src/index.js",
    "worker": "node dist/server/src/worker/index.js",
    "migrate": "node dist/db/migrate.js",
    "admin": "node dist/server/src/cli/create-admin.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build"
  },
  "dependencies": {
    "@iptv/playlist": "1.2.1",
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "express-validator": "7.3.2",
    "guarded-fetch": "^0.1.5",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "pg": "8.23.1",
    "vue": "3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "6.0.9",
    "daisyui": "^5.7.47",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  }
}
